/* Argus - layout and look. Colours come from the Textual theme (tokyo-night). */

Screen {
    layout: vertical;
    background: $background;
}

/* ---------------------------------------------------------------- chat */

#chat {
    height: 1fr;
    padding: 0 2 1 2;
    scrollbar-size-vertical: 1;
}

Welcome {
    color: $primary;
    padding: 2 2 1 2;
    width: auto;
}

UserMessage {
    margin: 1 0 0 0;
    padding: 0 1;
    border-left: thick $success;
    background: $boost;
    color: $foreground;
}

AssistantMessage {
    height: auto;
    margin: 1 0 0 0;
}

AssistantMessage Markdown {
    margin: 0;
    padding: 0 1;
    background: transparent;
}

Note {
    margin: 1 0 0 0;
    padding: 0 1;
    color: $text-muted;
}

Note.subagent {
    border-left: thick $accent;
}

Note.debug {
    color: $text-disabled;
}

ErrorNote {
    margin: 1 0 0 0;
    padding: 0 1;
    color: $error;
    border-left: thick $error;
}

/* Collapsibles: thinking, tool calls, compaction, debug. No boxes, just a
   clickable title line - closer to OpenCode than Textual's default card. */
Collapsible {
    border-top: none;
    background: transparent;
    padding: 0;
    margin: 0;
}

Collapsible > Contents {
    padding: 0 0 0 3;
}

CollapsibleTitle {
    padding: 0 1;
    color: $text-muted;
}

CollapsibleTitle:hover {
    background: $boost;
    color: $foreground;
}

CollapsibleTitle:focus {
    background: $boost;
}

/* the model's reasoning: faded, italic, folded away by default */
Thinking {
    margin-bottom: 1;
}

Thinking CollapsibleTitle {
    text-style: italic;
    color: $text-muted;
    text-opacity: 75%;
}

.thought-text {
    color: $text-muted;
    text-style: italic;
    text-opacity: 60%;
}

ToolCall {
    margin: 0;
}

ToolCall CollapsibleTitle {
    color: $warning;
}

ToolCall.failed CollapsibleTitle {
    color: $error;
}

ToolCall.nested {
    padding-left: 3;
}

.tool-output {
    color: $text-muted;
}

/* --------------------------------------------------------------- bottom */

#todos {
    height: auto;
    max-height: 12;
    margin: 0 2;
    padding: 0 1;
    border-left: thick $warning;
}

#composer {
    height: auto;
    max-height: 60%;
    padding: 0 2;
}

#suggest {
    display: none;
    height: auto;
    max-height: 12;
    border: round $panel-lighten-2;
    background: $surface;
}

#pending {
    height: auto;
    padding: 0 1;
    color: $warning;
}

#input {
    height: auto;
    min-height: 3;
    max-height: 12;
    border: round $primary;
    background: $surface;
}

#input:focus {
    border: round $accent;
}

StatusBar {
    height: 1;
    padding: 0 2;
    color: $text-muted;
}

/* -------------------------------------------------------------- dialogs */

PickScreen, SecretScreen, ApproveScreen {
    align: center middle;
    background: $background 60%;
}

.dialog {
    width: 90%;
    max-width: 110;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

.dialog-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.dialog-hint {
    color: $text-muted;
    margin-top: 1;
}

.dialog OptionList {
    height: auto;
    max-height: 24;
    border: none;
    background: transparent;
}

.dialog Input {
    border: round $panel-lighten-2;
}

.approve {
    border: round $warning;
}

.approve-reason {
    color: $warning;
    padding: 0 1;
}
